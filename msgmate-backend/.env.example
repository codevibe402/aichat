# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth (Dashboard > API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key
# Dashboard > Webhooks > your endpoint > Signing Secret. Needed by
# app/api/webhooks/clerk/route.ts to provision a User row on sign-up.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_your-webhook-signing-secret

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msgmate?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# AI provider
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional CORS allowlist for extension builds.
# Chrome extension origins look like chrome-extension://<extension-id>
EXTENSION_ORIGIN=chrome-extension://your-extension-id
