# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/msgmate?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# AI provider
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Session secret (generate with: openssl rand -base64 48)
SESSION_SECRET=your-session-secret-at-least-32-characters-long

# Google OAuth client ID (from Google Cloud Console)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: https://<extension-id>.chromiumapp.org/oauth/callback
# 4. Copy the client ID here
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional CORS allowlist for extension builds.
# Chrome extension origins look like chrome-extension://<extension-id>
EXTENSION_ORIGIN=chrome-extension://your-extension-id